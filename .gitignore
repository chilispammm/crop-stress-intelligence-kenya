# Data files & generated raster outputs (preserve directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/outputs/*
!data/outputs/.gitkeep

# Large geospatial raster and dataset formats
*.tif
*.tiff
*.nc
*.hdf
*.h5
*.gpkg
*.parquet
*.geoparquet
*.tar.gz
*.zip

# Logs and temporary files
*.log
tmp/
temp/
